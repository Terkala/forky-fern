# Objectives / round end
objective-issuer-mage = [color=#8866cc]The Ley[/color]
mage-round-end-agent-name = mage of ascension

# Briefing
mage-ascension-role-greeting-human = You are a Mage of Ascension. Ley confluences are forming on the station—find them, bind a grimoire from any book, and pry them open with the grimoire open in hand. Open enough of them to thin the veil until a single station-wide dimensional rift tears open (announced over CentComm channels). Any mage may race to pry it with an open grimoire—whoever finishes first is pulled through, and something else comes back wearing their face. Other mages are rivals; the crew will not tolerate your meddling.
mage-ascension-role-greeting-generic = You are a Mage of Ascension. Seek ley confluences, craft a grimoire, and open them until the veil thins enough that one dimensional rift opens on the station. Pry it before another mage does, or be left behind. Rivals and crew are obstacles.

# Objectives (rift beast)
objective-issuer-mage-rift-beast = [color=#cc4466]The Beyond[/color]
objective-mage-open-leylines-title = Open {$count} ley confluences
objective-mage-open-leylines-description = Each confluence you unravel weakens the dimensional barriers until you can reach Wizard Federation space.

objective-mage-dimensional-rift-title = Be first through the dimensional rift
objective-mage-dimensional-rift-description = When the veil tears, a single rift opens on the station. Pry it open with your grimoire before another mage does—only the first to finish the working walks out the other side.

# Dimensional rift
mage-dimensional-rift-spawned = The air tears with a sound like breaking glass. A rift nobody owns alone shivers into view—every mage will feel it.
mage-dimensional-rift-station-announcement = Unidentified dimensional instability detected near {$place}. All personnel: expect reality shear and unauthorized thaumaturgic egress attempts.
mage-dimensional-rift-announcement-place-unknown = an unknown location
mage-dimensional-rift-fail-not-station-rift = This rift does not respond to your grimoire.
mage-dimensional-rift-fail-already-opened = The breach has already been forced—nothing answers from the other side anymore.
mage-dimensional-rift-fail-someone-else = Another mage is already levering the seam—wait your turn or intervene.
mage-dimensional-rift-fail-not-mage = You cannot manipulate this rift.
mage-dimensional-rift-fail-grimoire = You need your open grimoire in hand to work the rift.
mage-dimensional-rift-fail-busy = You are already forcing the rift.
mage-dimensional-rift-pry-emote-1 = strains against the rift, knuckles white on the grimoire as the boundary bulges outward.
mage-dimensional-rift-pry-emote-2 = feels something massive press against the other side of the rift, testing the seam.
mage-dimensional-rift-pry-emote-3 = braces as claws—or teeth—scrape along the barrier from beyond.
mage-dimensional-rift-pry-emote-4 = nearly loses their footing as the rift screams and begins to give way.
mage-dimensional-rift-ascension-complete = Reality unzips. What staggers through is no longer the mage you were.

# Rift horrors (school bodies)
rift-big-honk-desc = A honkmother-sized joke with teeth and knuckles. The station is the punchline.
rift-elemental-creature-desc = A human-shaped knot of raw elemental flux, cycling through classical humors nobody asked for.
rift-big-honk-pie-name = Pie Barrage
rift-big-honk-pie-desc = Launch a cream pie at a point in space. Cheap, fast, humiliating.
rift-elemental-bolt-name = Elemental Burst
rift-elemental-bolt-desc = Hurl a bolt keyed to your current element.
rift-elemental-phase-name = Planar Slip
rift-elemental-phase-desc = Let the world slide through you for a few heartbeats. Do not linger in walls.
mage-big-honk-death-laugh = deflates with a wet, awful honk—like a trombone falling down an elevator shaft.

# Confluence
mage-confluence-fail-not-mage = You cannot sense this place of power.
mage-confluence-fail-grimoire = You need your grimoire in hand.
mage-confluence-opened = The ley line unravels into the station.
mage-confluence-research-no-server = No research server is linked to this station grid.
mage-confluence-research-drain = The confluence yields {$amount} research points.
mage-blink-fail-not-mage = You are not attuned to blink.
mage-blink-fail-no-mana = You have no mana pool.
mage-blink-fail-not-enough-mana = Not enough mana.
mage-blink-fail-los = You cannot blink there.

# Grimoire creation
mage-grimoire-fail-not-mage = Only a mage can bind a grimoire.
mage-grimoire-fail-has-grimoire = You already carry a grimoire.
mage-grimoire-fail-no-book = You need a mundane book in your active hand.
mage-grimoire-fail-not-book = That is not a suitable book.
mage-grimoire-fail-mana = You need 100 mana to bind a grimoire.
mage-grimoire-fail-busy = You are already channeling.
mage-grimoire-created = The book reshapes itself into your grimoire.

# Spell steal
mage-steal-fail-no-mind = There is no spark left to steal.
mage-steal-fail-nothing = There are no stolen spells left here.
mage-steal-fail-busy = You cannot do that yet.
mage-steal-success = You rip a spell from the corpse as it crumbles to ash.

# Lead gauntlets
lead-gauntlets-strip-denied = Brig access is required to remove these gauntlets.
